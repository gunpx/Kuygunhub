--// 🎄 Xmas Island Auto Farm + Boss Priority (Herta + Kafka)
--// by กัน (fixed & merged)

--===[ Services ]===--
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage.Remotes.Serverside

--===[ Settings ]===--
getgenv().AutoFarm = false
getgenv().AutoSkill = true
local Weapon = "Venuzdonoa"
local killCount = 0

--===[ Paths ]===--
local XmasIsland = workspace.Main.Characters["Xmas Island"]
local SnowFolder = XmasIsland:WaitForChild("Snow Brawler")
local BossNPC = workspace.Main.NPCs["Boss Spawn4"]

local KafkaBossPath = workspace.Main.Characters["Abyss Hill [Upper]"].Boss
local HertaPath = XmasIsland.Boss

--===[ Utils ]===--
local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart")
end

local function equipWeapon()
    local bp = player.Backpack:FindFirstChild(Weapon)
    if bp then bp.Parent = player.Character end
end

local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

--===[ Auto Haki + Obs ]===--
task.spawn(function()
    while true do
        if getgenv().AutoFarm then
            pcall(function()
                Remotes:FireServer("Server","Misc","Haki",1)
                Remotes:FireServer("Server","Misc","Observation",1)
            end)
        end
        task.wait(0.1)
    end
end)

--===[ Auto Skill (Boss Only) ]===--
local SkillKeys = {
    Enum.KeyCode.Z,
    Enum.KeyCode.X,
    Enum.KeyCode.C,
    Enum.KeyCode.V
}

local function useSkills()
    if not getgenv().AutoSkill then return end
    for _,key in pairs(SkillKeys) do
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
end

--===[ Attack Function ]===--
local function AttackTarget(mob, isBoss)
    local char, hrp = getChar()
    local hum = mob:FindFirstChildOfClass("Humanoid")
    local mhrp = mob:FindFirstChild("HumanoidRootPart")

    if hum and mhrp and hum.Health > 0 then
        equipWeapon()
        hrp.CFrame = mhrp.CFrame * CFrame.new(0,0,4)

        Remotes:FireServer("Server","Sword","M1s",Weapon,1)

        if isBoss then
            useSkills()
        end
        return true
    end
end

--===[ UI ]===--
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,220,0,130)
frame.Position = UDim2.new(0.75,0,0.1,0)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
frame.Active = true
frame.Draggable = true

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(1,-20,0,40)
toggle.Position = UDim2.new(0,10,0,10)
toggle.Text = "AutoFarm 🔴"

local counter = Instance.new("TextLabel", frame)
counter.Size = UDim2.new(1,-20,0,40)
counter.Position = UDim2.new(0,10,0,60)
counter.Text = "Kill : 0 / 100"
counter.TextColor3 = Color3.new(1,1,1)
counter.BackgroundTransparency = 1

toggle.MouseButton1Click:Connect(function()
    getgenv().AutoFarm = not getgenv().AutoFarm
    toggle.Text = getgenv().AutoFarm and "AutoFarm 🟢" or "AutoFarm 🔴"
end)

--===[ Main Loop ]===--
task.spawn(function()
    while true do
        if getgenv().AutoFarm then
            pcall(function()
                local char, hrp = getChar()

                -- 🔴 Priority 1 : Kafka
                local kafka = KafkaBossPath:FindFirstChild("Kafka")
                if kafka and kafka:FindFirstChild("Humanoid") and kafka.Humanoid.Health > 0 then
                    AttackTarget(kafka, true)
                    return
                end

                -- 🔴 Priority 2 : Farm Snow Brawler
                for _,mob in pairs(SnowFolder:GetChildren()) do
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        AttackTarget(mob, false)
                        hum.Died:Wait()
                        killCount += 1
                        counter.Text = "Kill : "..killCount.." / 100"
                        break
                    end
                end

                -- 🔴 ครบ 100 → เสก Herta
                if killCount >= 100 then
                    hrp.CFrame = BossNPC.HumanoidRootPart.CFrame * CFrame.new(0,0,3)
                    task.wait(0.5)
                    pressE()
                    killCount = 0
                end

                -- 🔴 ตี Herta
                local herta = HertaPath:FindFirstChild("Herta")
                if herta and herta:FindFirstChild("Humanoid") and herta.Humanoid.Health > 0 then
                    AttackTarget(herta, true)
                end
            end)
        end
        task.wait(0.3)
    end
end)
