--// 🎄 Xmas AutoFarm + Kafka Priority + UI + AutoSkill (Boss Only) + AutoHaki
--// Full Script

--================ SERVICES =================--
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage.Remotes.Serverside

--================ SETTINGS =================--
local Weapon = "Shadow"
local Delay = 0.1
local TARGET_KILL = 100

getgenv().AutoFarm = true
getgenv().AutoSkill = true
getgenv().AutoHaki = true

--================ MAP =================--
local XmasIsland = workspace.Main.Characters["Xmas Island"]
local SnowFolder = XmasIsland["Snow Brawler"]
local XmasBossFolder = XmasIsland.Boss
local SpawnNPC = workspace.Main.NPCs["Boss Spawn4"]

local KafkaBossFolder = workspace.Main.Characters["Abyss Hill [Upper]"].Boss

--================ STATES =================--
local killCount = 0
local doingKafka = false
local isBossFight = false

--================ BASIC =================--
local function waitForCharacter()
    local char, hrp, hum
    repeat
        char = player.Character or player.CharacterAdded:Wait()
        hrp = char:FindFirstChild("HumanoidRootPart")
        hum = char:FindFirstChild("Humanoid")
        task.wait()
    until hrp and hum and hum.Health > 0
    return char, hrp, hum
end

local function AutoEquipWeapon()
    pcall(function()
        local tool = player.Backpack:FindFirstChild(Weapon)
        if tool then tool.Parent = player.Character end
    end)
end

--================ PRESS E =================--
local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

--================ AUTOSKILL =================--
local SkillKeys = {
    Z = Enum.KeyCode.Z,
    X = Enum.KeyCode.X,
    C = Enum.KeyCode.C,
    V = Enum.KeyCode.V
}
local UseSkills = {"Z","X","C","V"}

local function pressSkill(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

task.spawn(function()
    while true do
        if getgenv().AutoSkill and isBossFight and getgenv().AutoFarm then
            for _,s in ipairs(UseSkills) do
                pressSkill(SkillKeys[s])
                task.wait(0.15)
            end
        end
        task.wait(0.3)
    end
end)

--================ AUTO HAKI =================--
task.spawn(function()
    while true do
        if getgenv().AutoFarm and getgenv().AutoHaki then
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    Remotes:FireServer("Server","Misc","Haki",1)
                    Remotes:FireServer("Server","Misc","Observation",1)
                end
            end)
        end
        task.wait(0.3)
    end
end)

--================ UI =================--
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "XmasFarmUI"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,240,0,170)
frame.Position = UDim2.new(0.75,0,0.15,0)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,35)
title.Text = "🎄 Xmas AutoFarm"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 18

local counter = Instance.new("TextLabel", frame)
counter.Position = UDim2.new(0,0,0,40)
counter.Size = UDim2.new(1,0,0,30)
counter.Text = "Kill : 0 / 100"
counter.TextColor3 = Color3.new(1,1,1)
counter.BackgroundTransparency = 1
counter.Font = Enum.Font.Gotham
counter.TextSize = 16

local status = Instance.new("TextLabel", frame)
status.Position = UDim2.new(0,0,0,70)
status.Size = UDim2.new(1,0,0,30)
status.Text = "Status : Farming"
status.TextColor3 = Color3.fromRGB(0,255,0)
status.BackgroundTransparency = 1
status.Font = Enum.Font.Gotham
status.TextSize = 15

local toggle = Instance.new("TextButton", frame)
toggle.Position = UDim2.new(0.1,0,0,115)
toggle.Size = UDim2.new(0.8,0,0,35)
toggle.Text = "AutoFarm : ON"
toggle.BackgroundColor3 = Color3.fromRGB(0,170,0)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 16
toggle.BorderSizePixel = 0

toggle.MouseButton1Click:Connect(function()
    getgenv().AutoFarm = not getgenv().AutoFarm
    if getgenv().AutoFarm then
        toggle.Text = "AutoFarm : ON"
        toggle.BackgroundColor3 = Color3.fromRGB(0,170,0)
        status.Text = "Status : Farming"
        status.TextColor3 = Color3.fromRGB(0,255,0)
    else
        toggle.Text = "AutoFarm : OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(170,0,0)
        status.Text = "Status : Paused"
        status.TextColor3 = Color3.fromRGB(255,0,0)
    end
end)

--================ ATTACK =================--
local function AttackTarget(model)
    local _, hrp = waitForCharacter()
    local hum = model:FindFirstChild("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end

    AutoEquipWeapon()
    hrp.CFrame = root.CFrame * CFrame.new(0,0,5)

    Remotes:FireServer("Server","Sword","M1s",Weapon,1)
    task.wait(0.1)
    for i=1,4 do
        Remotes:FireServer("Server","Sword","Skill"..i,Weapon)
        task.wait(Delay)
    end
end

--================ SPAWN HERTA =================--
local function SpawnHerta()
    local _, hrp = waitForCharacter()
    status.Text = "Status : Spawning Herta"
    status.TextColor3 = Color3.fromRGB(255,170,0)

    hrp.CFrame = SpawnNPC.HumanoidRootPart.CFrame * CFrame.new(0,0,3)
    task.wait(0.6)
    for i=1,3 do
        pressE()
        task.wait(0.5)
    end
end

--================ KAFKA =================--
local function AttackKafka()
    local boss = KafkaBossFolder:FindFirstChild("Kafka")
    if not boss or not boss:FindFirstChild("Humanoid") then return end

    doingKafka = true
    isBossFight = true
    status.Text = "Status : Fighting Kafka"
    status.TextColor3 = Color3.fromRGB(255,80,80)

    while boss.Humanoid.Health > 0 and getgenv().AutoFarm do
        AttackTarget(boss)
        task.wait(0.25)
    end

    doingKafka = false
    isBossFight = false
    status.Text = "Status : Farming"
    status.TextColor3 = Color3.fromRGB(0,255,0)
end

task.spawn(function()
    while true do
        if getgenv().AutoFarm and not doingKafka then
            local boss = KafkaBossFolder:FindFirstChild("Kafka")
            if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                AttackKafka()
            end
        end
        task.wait(5)
    end
end)

--================ MAIN FARM =================--
task.spawn(function()
    while true do
        if getgenv().AutoFarm and not doingKafka then
            local herta = XmasBossFolder:FindFirstChild("Herta")

            if herta and herta:FindFirstChild("Humanoid") and herta.Humanoid.Health > 0 then
                isBossFight = true
                AttackTarget(herta)

            elseif killCount >= TARGET_KILL then
                counter.Text = "Kill : 100 / 100"
                SpawnHerta()
                task.wait(3)

            else
                isBossFight = false
                for _,mob in pairs(SnowFolder:GetChildren()) do
                    if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        AttackTarget(mob)
                        mob.Humanoid.Died:Wait()
                        killCount += 1
                        counter.Text = "Kill : "..killCount.." / 100"
                        break
                    end
                end
            end
        end
        task.wait(0.25)
    end
end)

--================ RESET AFTER HERTA =================--
task.spawn(function()
    while true do
        local herta = XmasBossFolder:FindFirstChild("Herta")
        if herta and herta:FindFirstChild("Humanoid") then
            herta.Humanoid.Died:Wait()
            killCount = 0
            counter.Text = "Kill : 0 / 100"
        end
        task.wait(1)
    end
end)

--================ PROXIMITY PROMPT FAST =================--
for _, obj in pairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
    end
end
