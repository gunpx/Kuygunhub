-- 🔄 MAIN LOOP (PITY + WARP)
------------------------------------------------
task.spawn(function()
	while true do
		local value = pityBoss.Value
		PityText.Text = "Pity : " .. value
		PityText.TextColor3 =
			(value == 25)
			and Color3.fromRGB(255,80,80)
			or Color3.fromRGB(80,255,80)

		if autoFarm then
			if value == 25 then
				warpToBoss("Abyss Hill [Upper]", "Anos")
			else
				warpToBoss("Throne Isle", "Sukuna")
			end
		end

		task.wait(1)
	end
end)
