-- Helper: set button visuals
local function setButtonState(btn, enabled)
    local baseText = (btn and btn.Text) or ""
    baseText = string.gsub(baseText, "✅","")
    baseText = string.gsub(baseText, "❌","")
    baseText = string.match(baseText, "^[^%s].*") or baseText -- keep text
    btn.Text = baseText .. " " .. (enabled and "✅" or "❌")
    btn.BackgroundColor3 = enabled and Color3.fromRGB(0,150,0) or Color3.fromRGB(70,70,70)
end

