    while true do
        pcall(function()
            local area = workspace.Main and workspace.Main.Characters and workspace.Main.Characters["Rogue Town"]
            local bossFolder = area and area:FindFirstChild("Boss")
            local sjw = bossFolder and bossFolder:FindFirstChild("Sung Jin Woo")
            if sjw and sjw:FindFirstChild("Humanoid") and sjw.Humanoid.Health > 0 then
                latestSJW = sjw
            else
