    while task.wait(0.5) do
        if getgenv().AutoMihawkSJW then
            local sjw = latestSJW
            if sjw then
                attackTargetWithSword(sjw, getgenv().AutoWeaponName or DEFAULT_WEAPON)
            else
                local mihawk = nil
                pcall(function()
                    local area = workspace.Main and workspace.Main.Characters and workspace.Main.Characters["Glacier Isle"]
                    if area and area:FindFirstChild("Mihawk") then
                        mihawk = area.Mihawk:FindFirstChild("Mihawk") or area.Mihawk
                    end
                end)
                if mihawk and mihawk:FindFirstChild("Humanoid") and mihawk.Humanoid.Health > 0 then
                    attackTargetWithSword(mihawk, getgenv().AutoWeaponName or DEFAULT_WEAPON)
                else
                    -- teleport to a known quest pos (use Sukuna quest as fallback)
                    teleportToQuest(QUEST_CFRAME_SUKUNA)
                end
            end
        end
    end
end)

--===[ Camera AutoZoom ]===--
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = player.Character
        if not char then return end
        if not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Head") then return end
        if getgenv().AutoZoom then
            camera.CameraType = Enum.CameraType.Scriptable
            local camPos = char.HumanoidRootPart.Position + Vector3.new(0,50,0)
            camera.CFrame = CFrame.new(camPos, char.Head.Position)
        else
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
        end
    end)
end)

