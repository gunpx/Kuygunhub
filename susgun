--===[ ฟังก์ชัน Toggle AutoFarm ]===--
local function ToggleAutoFarm(state)
    getgenv().AutoFarmMihawk = state
    if state then
        autoFarmBtn.Text = "AutoFarm 🟢"
        autoFarmBtn.BackgroundColor3 = Color3.fromRGB(0,170,0)
    else
