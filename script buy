-- ฟังก์ชัน Equip Weapon
function EquipWeapon(Tool)
    pcall(function()
        if player.Backpack:FindFirstChild(Tool) then 
            local toolObj = player.Backpack:FindFirstChild(Tool) 
            player.Character.Humanoid:EquipTool(toolObj) 
        end
    end)
end

function Equipcombat()
    for _, v in pairs(player.Backpack:GetChildren()) do
        if v.ToolTip == "Combat" and player.Backpack:FindFirstChild(v.Name) then
            EquipWeapon(v.Name)
        end
    end
end

function Equipsword()
    for _, v in pairs(player.Backpack:GetChildren()) do
        if v.ToolTip == "Sword" and player.Backpack:FindFirstChild(v.Name) then
            EquipWeapon(v.Name)
        end
    end
end

function Equipfruit()
    for _, v in pairs(player.Backpack:GetChildren()) do
        if v.ToolTip == "Fruit" and player.Backpack:FindFirstChild(v.Name) then
            EquipWeapon(v.Name)
        end
    end
end

local function equipSelectedWeapon()
    if selectedWeaponType == "Combat" then
        Equipcombat()
    elseif selectedWeaponType == "Sword" then
