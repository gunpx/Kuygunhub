-- ฟังก์ชัน Teleport
local function teleportTo(target)
    pcall(function()
        if not rootPart then return end
        local cf = nil
        if target:IsA("Model") then
            if target.PrimaryPart then
                cf = target.PrimaryPart.CFrame
            elseif target:FindFirstChild("HumanoidRootPart") then
                cf = target.HumanoidRootPart.CFrame
            else
                local part = target:FindFirstChildWhichIsA("BasePart")
                if part then cf = part.CFrame end
            end
        elseif target:IsA("BasePart") then
            cf = target.CFrame
        end
        if cf then
            rootPart.CFrame = cf
        end
    end)
end

-- ฟังก์ชันหา Monster
local function findAllMonsters(monsterName)
    local data = MonsterData[monsterName]
    if not data or not data.folder then return {} end

    local aliveMonsters = {}
    for _, v in pairs(data.folder:GetChildren()) do
        if v.Name == data.name 
            and v:IsA("Model") 
            and v:FindFirstChild("Humanoid") 
            and v:FindFirstChild("HumanoidRootPart")
            and v.Humanoid.Health > 0 then
            table.insert(aliveMonsters, v)
        end
    end
    return aliveMonsters
end

-- ฟังก์ชันเช็ค Quest
local function hasQuest()
    local hud = player.PlayerGui:FindFirstChild("HUD")
    if not hud then return false end
    local questFrame = hud:FindFirstChild("Bar").List:FindFirstChild("Quest")
    return questFrame and questFrame:IsA("Frame")
end

local function getQuestTitle()
    local success, result = pcall(function()
        local hud = player.PlayerGui:FindFirstChild("HUD")
        if not hud then return nil end
        local label = hud:FindFirstChild("Bar").List.Quest.Bar.Label
        if label and label:IsA("TextLabel") and label.Text ~= "" then
            return label.Text
        end
        return nil
    end)
    return success and result or nil
end

local function extractMonsterFromQuest(questText)
    if not questText or questText == "" then return nil end
    local patterns = { "Defeat%s+(.+)", "Kill%s+%d+%s+(.+)", "Defeat%s+%d+%s+(.+)", "Eliminate%s+(.+)" }
    for _, p in ipairs(patterns) do
        local m = string.match(questText, p)
        if m and m ~= "" then
            return string.gsub(m, "%s*$", "")
        end
    end
    return nil
end

local function getQuestMonster()
    local title = getQuestTitle()
    if not title then return nil end
    return extractMonsterFromQuest(title)
end

local function isQuestMatching(questMonster, selectedMonster)
    if not questMonster or not selectedMonster then return false end
    return string.find(questMonster, selectedMonster) or string.find(selectedMonster, questMonster)
end

local function findQuestNPC(monsterName)
    for _, npc in pairs(workspace.Main.NPCs.Quests:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("Quest") and npc.Quest:FindFirstChild("Title") then
            local title = npc.Quest.Title.Value
            local npcMonster = extractMonsterFromQuest(title)
            if npcMonster and (string.find(npcMonster, monsterName) or string.find(monsterName, npcMonster)) then
                return npc, title
            end
        end
    end
    return nil
end

